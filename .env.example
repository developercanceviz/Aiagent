# ─────────────────────────────────────────────────────────────
# ikas (commerce adapter — Phase 1)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_GRAPH_API_URL=https://api.myikas.com/api/v2/admin/graphql
NEXT_PUBLIC_IKAS_CLIENT_ID=
IKAS_CLIENT_SECRET=
NEXT_PUBLIC_DEPLOY_URL=http://localhost:3000
SECRET_COOKIE_PASSWORD=        # >=32 chars, random — iron-session encryption

# ─────────────────────────────────────────────────────────────
# Supabase (Postgres + Auth + Realtime + Storage + pgvector)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=                  # pooled connection string (prisma client)
DIRECT_URL=                    # direct connection (prisma migrate)

# ─────────────────────────────────────────────────────────────
# AI (Phase 2+) — set ONE chat provider key; AI_PROVIDER forces a choice
# when both are present. EMBEDDINGS_PROVIDER_KEY is OpenAI-compatible
# (may be the same value as OPENAI_API_KEY).
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_PROVIDER=                   # anthropic | openai (optional)
OPENAI_CHAT_MODEL=             # default gpt-5.1
OPENAI_CLASSIFIER_MODEL=       # default gpt-5-mini
EMBEDDINGS_PROVIDER_KEY=

# ─────────────────────────────────────────────────────────────
# Crypto — token encryption at rest (AES-256-GCM)
# ─────────────────────────────────────────────────────────────
ENCRYPTION_KEY=                # 32-byte base64 key. Generate: openssl rand -base64 32

# ─────────────────────────────────────────────────────────────
# Meta channels (Phase 9 — WhatsApp Cloud / Instagram DM / Messenger)
# ─────────────────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
